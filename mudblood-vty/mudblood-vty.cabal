-- Initial mudblood-vty.cabal generated by cabal init.  For further 
-- documentation, see http://haskell.org/cabal/users-guide/

name:                mudblood-vty
version:             0.1.0.0
license:             GPL-3
license-file:        LICENSE
author:              Philip Kranz
maintainer:          philip.kranz@googlemail.com
category:            Game
build-type:          Simple
cabal-version:       >=1.10

library
  exposed-modules:     Mudblood.Screen.Vty
                     , Data.List.Flatten
  other-modules:       Mudblood.Screen.Vty.Widgets
                     , Mudblood.Screen.Vty.Monad
                     , Mudblood.Screen.Vty.Draw
                     , Mudblood.Screen.Vty.Keys
                     , Mudblood.Screen.Vty.Layout
                     , Mudblood.Screen.Vty.Select
                     , Mudblood.Screen.Vty.Lines
                     , Mudblood.Screen.Vty.UserWidget
                     , Control.Interactive
                     , Data.History
                     , Data.Buffer
                     , Data.PrefixZipper
                     , Graphics.Vty.Widget
  other-extensions:    GeneralizedNewtypeDeriving, MultiParamTypeClasses, FlexibleInstances, FlexibleContexts
  build-depends:       base, containers, mtl, process, utf8-string, time, bifunctors, semigroupoids
                     , parsec
                     , MissingH
                     , vty
                     , vty-crossplatform
                     , mudblood
                     , stm
                     , old-locale
                     , safe
                     , comonad
                     , free
                     , lens
  hs-source-dirs:      src
  ghc-options:         -O1 -auto-all -caf-all
  default-language:    Haskell2010

Test-Suite flatten-tests
  type:           exitcode-stdio-1.0
  hs-source-dirs: test
  build-depends:  base, Cabal, HUnit, QuickCheck, mudblood-vty, mtl, test-framework, test-framework-quickcheck2, test-framework-hunit, transformers
  main-is:        Flatten.hs
  ghc-options:    -O1 -auto-all -caf-all

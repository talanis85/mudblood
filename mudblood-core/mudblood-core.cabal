-- Initial mudblood.cabal generated by cabal init.  For further 
-- documentation, see http://haskell.org/cabal/users-guide/

name:                mudblood-core
version:             0.1.0.0
-- synopsis:            
-- description:         
license:             GPL-3
license-file:        LICENSE
author:              Philip Kranz
maintainer:          philip.kranz@googlemail.com
-- copyright:           
category:            Game
build-type:          Simple
-- extra-source-files:  
cabal-version:       >=1.10

test-suite test-trigger
  type:                detailed-0.9
  test-module:         Trigger
  hs-source-dirs:      test
  build-depends:       mudblood-core >=0.1, base >=4.5 && <4.6, mtl >=2.1 && <2.2, HUnit >=1.2.4, Cabal >=1.20
  default-language:    Haskell2010

library
  exposed-modules:     Mudblood
                     , Mudblood.Class
                     , Mudblood.Core
                     , Mudblood.Keys
                     , Mudblood.Error
                     , Mudblood.Text
                     , Mudblood.Screen.Simple
                     , Mudblood.Telnet
                     , Mudblood.Trigger
                     , Data.GMCP
                     , Data.Menu
                     , Control.DynCallback
                     , Control.Trigger
                     , Control.Trigger.Monad
                     , Control.Trigger.Arrow
                     , Control.Trigger.Aux
  other-modules:       Mudblood.Utils
  default-extensions:  MultiParamTypeClasses
  other-extensions:    GeneralizedNewtypeDeriving
                     , UndecidableInstances
                     , FlexibleInstances
                     , FlexibleContexts
                     , ScopedTypeVariables
                     , DeriveDataTypeable
  build-depends:       base >=4.5 && <4.6
                     , parsec >=3.1 && <3.2, split >=0.2 && <0.3, mtl >=2.1 && <2.2
                     , containers >=0.4 && <0.5, utf8-string >=0.3 && <0.4
                     , bytestring >=0.9 && <0.10, binary >=0.5 && <0.6, network >=2.5 && <2.6
                     , json >=0.7 && <0.8, stm >=2.4 && <2.5, time >=1.4 && <1.5
                     , MissingH >=1.2 && <1.3, bifunctors >=4.1 && <4.2
                     , Cabal >=1.20 && <1.21, HUnit >=1.2 && <1.3, monad-coroutine >=0.8 && <0.9
  hs-source-dirs:      src
  default-language:    Haskell2010

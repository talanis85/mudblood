name:                mudblood
version:             0.1.0.0
license:             GPL-3
license-file:        LICENSE
author:              Philip Kranz
maintainer:          philip.kranz@googlemail.com
category:            Game
build-type:          Simple
cabal-version:       >=1.10

library
  exposed-modules:     Mudblood
                     , Mudblood.Class
                     , Mudblood.Component
                     , Mudblood.Core
                     , Mudblood.Monad
                     , Mudblood.Keys
                     , Mudblood.Error
                     , Mudblood.Encoding
                     , Mudblood.Text
                     , Mudblood.Screen
                     , Mudblood.Screen.Simple
                     , Mudblood.Screen.Dummy
                     , Mudblood.Telnet
                     , Mudblood.Trigger
                     , Mudblood.Mapper
                     , Mudblood.UserData

                     , Mudblood.Trigger.Event
                     , Mudblood.Trigger.Regex
                     , Mudblood.Trigger.EventLog
                     , Mudblood.Trigger.Logfile

                     , Mudblood.Component.Logfile
                     , Mudblood.Component.Debug
                     , Mudblood.Component.Assets

                     , Data.GMCP
                     , Data.Menu
                     , Data.Carte
                     , Data.DynEnv
                     , Data.Trie
                     , Data.QuasiEq
                     , Data.ListZipper

                     , Control.Component.Stateful
                     , Control.UnsafeCallback
                     , Control.Monad.Except
                     , Control.Command
                     , Control.Trigger

                     , Unsafe.Any

  other-modules:       Mudblood.Mapper.Map
                     , Mudblood.Mapper.Walk

                     , Text.Parsec.Word8

                       Control.Trigger.Core
                     , Control.Trigger.Iteration
                     , Control.Trigger.Parser
                     , Control.Trigger.Lift

  default-extensions:  MultiParamTypeClasses
                     , TypeOperators
                     , NoMonomorphismRestriction
                     , RankNTypes
                     , FlexibleContexts

  other-extensions:    GeneralizedNewtypeDeriving
                     , UndecidableInstances
                     , FlexibleInstances
                     , ScopedTypeVariables
                     , DeriveDataTypeable

  build-depends:       base         == 4.7.*
                     , parsec       == 3.1.*
                     , split        == 0.2.*
                     , mtl          == 2.1.*
                     , transformers == 0.3.*
                     , containers   == 0.5.*
                     , utf8-string  == 1
                     , bytestring   == 0.10.*
                     , binary       == 0.7.*
                     , network      == 2.6.*
                     , json         == 0.9.*
                     , stm          == 2.4.*
                     , time         == 1.4.*
                     , MissingH     == 1.3.*
                     , bifunctors   == 4.2.*
                     , free         == 4.11.*
                     , fgl          == 5.5.*
                     , mmorph       == 1.0.*
                     , lens         == 4.7.*
                     , cereal       == 0.4.*
                     , data-default == 0.5.*
                     , regex-tdfa   == 1.2.*
                     , base64-bytestring == 1.0.*
                     , array        == 0.5.*
                     , ghc-prim     == 0.3.*
                     , filepath     == 1.3.*
                     , semigroups   == 0.16.*

  hs-source-dirs:      src
  ghc-options:         -O1 -auto-all -caf-all
  default-language:    Haskell2010

test-suite mudblood-trigger-test
  type:                exitcode-stdio-1.0
  hs-source-dirs:      test
  main-is:             Trigger.hs
  build-depends:       base
                     , mtl
                     , transformers
                     , HUnit
                     , QuickCheck
                     , test-framework
                     , test-framework-hunit
                     , test-framework-quickcheck2
                     , mudblood
  ghc-options:         -threaded -rtsopts -with-rtsopts=-N
  default-language:    Haskell2010
